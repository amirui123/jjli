{
  "name": "rtl-motion-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-toolkit-manifest.mjs && node scripts/generate-public-vault.mjs",
    "dev": "npm run generate && vite --host 0.0.0.0 --port 5173",
    "build": "npm run generate && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}