{
  "name": "rtl-motion-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-toolkit-manifest.mjs && node scripts/generate-public-vault.mjs && node scripts/generate-font-files.mjs && node scripts/generate-component-chunks.mjs && node scripts/generate-light-data.mjs",
    "postinstall": "node scripts/ensure-esbuild.mjs",
    "dev": "npm run generate && vite --host 0.0.0.0 --port 5173",
    "build": "npm run generate && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "chunks": "node scripts/generate-component-chunks.mjs",
    "lint": "eslint src scripts",
    "standalone": "node scripts/build-standalone.mjs",
    "single": "node scripts/build-single-file.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
