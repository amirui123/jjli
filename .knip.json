{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/dev/smoke.tsx",
    "scripts/*.mjs",
    "tools/*.mjs",
    "e2e/**/*.spec.ts",
    "src/data/soundsManifest.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "scripts/**/*.mjs",
    "tools/**/*.mjs",
    "e2e/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-preset-recommend",
    "lighthouse",
    "lottie-web",
    "motion",
    "tempus"
  ]
}
