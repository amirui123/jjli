{
  "name": "clone-any-website-skill",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Deterministic verification runner for measured website reconstruction",
  "scripts": {
    "verify": "node clone-any-website/scripts/run-verification.mjs",
    "test": "node --test tests/node/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests/python -p 'test_*.py'",
    "test:smoke": "node --test --test-concurrency=1 tests/smoke/*.test.mjs",
    "check": "npm run test && npm run test:python && npm run test:smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "playwright": "^1.55.0",
    "yaml": "^2.8.1"
  }
}
