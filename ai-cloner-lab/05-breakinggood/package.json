{
  "name": "breakinggood",
  "version": "0.2.0",
  "description": "One command to clone, reverse-engineer and run any software from a URL. GitHub repo → safely installed and running. Website → rebuilt as a runnable React project with a mock API.",
  "type": "module",
  "bin": {
    "breakinggood": "dist/cli.js",
    "bg": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "clone",
    "reverse-engineering",
    "website-to-code",
    "github",
    "cli",
    "ai",
    "react",
    "tailwind",
    "playwright",
    "one-command",
    "developer-tools"
  ],
  "author": "Eklavya Pandey <pandeyeklavya220@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eklavya2201/breakinggood.git"
  },
  "homepage": "https://github.com/eklavya2201/breakinggood#readme",
  "bugs": {
    "url": "https://github.com/eklavya2201/breakinggood/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.64.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
