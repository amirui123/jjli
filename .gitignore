node_modules/
dist/
.DS_Store

# vendored source corpus (76MB / 7035 files) — regenerate the derived vault with `npm run generate`
toolkit/

# temporary build artifacts
dist-vercel/
dist-single/

# smoke bundle output
.smoke/

# shareable copy: only the finished single-file deliverable is versioned (it is
# built on demand); zips and other exports stay local
share/*
!share/rtl-motion-lab-standalone.html

# local audit toolchain (browser binary, shared libs, python venv) — rebuilt by `npm run tool:setup`
.tooling/
# audit output (screenshots, raw captures) is tool output, not source.
# The Markdown reports themselves are tracked explicitly with `git add -f`.
audit/
# backstop creates its runtime scratch dir on first run
backstop_data/
# playwright artefacts
playwright-report/
test-results/
.backstopjs/
.lighthouseci/
